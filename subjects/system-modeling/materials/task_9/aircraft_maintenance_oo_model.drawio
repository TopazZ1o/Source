dth="28" height="16" as="geometry"/></mxCell><mxCell id="p2_c83" value="автор" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#000000;fontStyle=2;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1374" y="378" width="70" height="14" as="geometry"/></mxCell><mxCell id="p2_e84" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;endFill=0;startArrow=none;startFill=0;strokeColor=#000000;strokeWidth=1;endSize=8;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="156" as="sourcePoint"/><mxPoint x="1340" y="658" as="targetPoint"/><Array as="points"><mxPoint x="60" y="905"/><mxPoint x="1370" y="905"/><mxPoint x="1370" y="658"/></Array></mxGeometry></mxCell><mxCell id="p2_c85" value="0..*" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1345" y="640" width="28" height="16" as="geometry"/></mxCell><mxCell id="p2_c86" value="пользователь" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#000000;fontStyle=2;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1374" y="648" width="70" height="14" as="geometry"/></mxCell><mxCell id="p2_e87" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;endFill=0;startArrow=none;startFill=0;strokeColor=#000000;strokeWidth=1;endSize=8;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="156" as="sourcePoint"/><mxPoint x="880" y="642.25" as="targetPoint"/><Array as="points"><mxPoint x="60" y="905"/><mxPoint x="880" y="905"/></Array></mxGeometry></mxCell><mxCell id="p2_c88" value="0..*" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="884" y="650.25" width="28" height="16" as="geometry"/></mxCell><mxCell id="p2_c89" value="утвердил" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#000000;fontStyle=2;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="886" y="666.25" width="80" height="14" as="geometry"/></mxCell><mxCell id="p2_c90" value="1" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontColor=#000000;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="162" width="22" height="16" as="geometry"/></mxCell><mxCell id="p2_c91" value="Ограничения предметной области&lt;br&gt;1. У ВС не более одной активной заявки.&lt;br&gt;2. Активные назначения одного ресурса не пересекаются по времени.&lt;br&gt;3. Допуск — только после завершения обязательных этапов, при отсутствии открытых критичных дефектов и при заключении «годно».&lt;br&gt;4. Списанное ВС не планируется. 5. Заключение, акт списания и запись журнала не изменяются и не удаляются.&lt;br&gt;6. Статус ВС меняется только по допустимым переходам (рис. 9)." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="730" width="500" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3_d" name="3. Проектная модель классов: предметная область"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1984" pageHeight="783" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_c1" value="ВоздушноеСудно" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="440" height="23" as="geometry"/></mxCell><mxCell id="p3_c2" value="-идВС: int&lt;br&gt;-бортовойНомер: str&lt;br&gt;-модель: str&lt;br&gt;-серийныйНомер: str&lt;br&gt;-датаВвода: date&lt;br&gt;-статус: СтатусВС&lt;br&gt;-срокСледующегоТО: date [0..1]" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="43" width="440" height="104.25" as="geometry"/></mxCell><mxCell id="p3_c3" value="+зарезервироватьОбслуживание(): void&lt;br&gt;+отменитьРезерв(): void&lt;br&gt;+начатьОбслуживание(): void&lt;br&gt;+ограничить(): void&lt;br&gt;+выдатьДопуск(зн: ЗаказНаряд, срокТО: date): void&lt;br&gt;+списать(): void&lt;br&gt;+просрочено(сегодня: date): bool&lt;br&gt;+срокБлизко(сегодня: date, дни: int): bool&lt;br&gt;-перейти(новый: СтатусВС): void" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="147.25" width="440" height="131.75" as="geometry"/></mxCell><mxCell id="p3_c5" value="ЗаявкаНаОбслуживание" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="20" width="440" height="23" as="geometry"/></mxCell><mxCell id="p3_c6" value="-идЗаявки: int&lt;br&gt;-идВС: int&lt;br&gt;-идАвтора: int&lt;br&gt;-тип: ТипОбслуживания&lt;br&gt;-приоритет: Приоритет&lt;br&gt;-желаемаяДата: date [0..1]&lt;br&gt;-описание: str&lt;br&gt;-статус: СтатусЗаявки&lt;br&gt;-недостающее: list&lt;str&gt;" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="580" y="43" width="440" height="131.75" as="geometry"/></mxCell><mxCell id="p3_c7" value="+отметитьУточнение(недостающее: list&lt;str&gt;): void&lt;br&gt;+отметитьУточнено(): void&lt;br&gt;+назначить(): void&lt;br&gt;+запроситьОжидание(): void&lt;br&gt;+начать(): void&lt;br&gt;+завершить(): void&lt;br&gt;+отменить(): void&lt;br&gt;+активна(): bool&lt;br&gt;+тоЖеСодержание(идАвтора, тип, дата, описание): bool&lt;br&gt;-перейти(новый: СтатусЗаявки): void" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="580" y="174.75" width="440" height="145.5" as="geometry"/></mxCell><mxCell id="p3_c9" value="ЗаказНаряд" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="20" width="460" height="23" as="geometry"/></mxCell><mxCell id="p3_c10" value="-идЗН: int&lt;br&gt;-идЗаявки: int&lt;br&gt;-идВС: int&lt;br&gt;-статус: СтатусЗН" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1160" y="43" width="460" height="63" as="geometry"/></mxCell><mxCell id="p3_c11" value="+добавитьЭтап(название: str, обязательный: bool, идИсполнителя: int): ЭтапРабот&lt;br&gt;+начать(): void&lt;br&gt;+закрытьЭтап(идЭтапа: int, идИсполнителя: int, результат: str): void&lt;br&gt;+зафиксироватьДефект(описан