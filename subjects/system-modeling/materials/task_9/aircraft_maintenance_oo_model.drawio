ён, заключение кл1 «годно»." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="340" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11_d" name="11. Диаграмма состояний заявки после изменения требований"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1044" pageHeight="784" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11_c1" value="Требует уточнения" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="200" height="54" as="geometry"/></mxCell><mxCell id="p11_c2" value="Завершена" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="200" height="54" as="geometry"/></mxCell><mxCell id="p11_c3" value="Новая" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="200" height="54" as="geometry"/></mxCell><mxCell id="p11_c4" value="Запланирована" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mx