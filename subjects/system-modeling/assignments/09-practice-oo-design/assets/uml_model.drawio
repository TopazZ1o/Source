idth=1;endSize=8;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="460" as="sourcePoint"/><mxPoint x="810" y="553" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1_e30" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;startArrow=none;startFill=0;strokeColor=#000000;strokeWidth=1;endSize=8;startSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="160" as="sourcePoint"/><mxPoint x="675" y="122" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1_c31" value="«include»" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#000000;fontStyle=2;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="683" y="128" width="80" height="16" as="geometry"/></mxCell><mxCell id="p1_e32" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=open;endFill=0;startArrow=none;startFill=0;strokeColor=#000000;strokeWidth=1;endSize=8;startSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="675" y="240" as="sourcePoint"/><mxPoint x="675" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1_c33" value="«extend»" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#000000;fontStyle=2;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="683" y="209" width="80" height="16" as="geometry"/></mxCell><mxCell id="p1_c34" value="«include»: компетенция и нагрузка проверяются при каждом назначении (BR-03), поэтому это обязательная часть UC-05.&lt;br&gt;«extend»: диспетчер может посмотреть нагрузку до выбора специалиста; без просмотра назначение возможно – поведение необязательное." style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeome