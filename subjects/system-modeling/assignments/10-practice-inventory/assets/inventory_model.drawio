gt;order_cost  &gt; 0   (S)&lt;br&gt;holding_cost  &gt; 0   (H)&lt;br&gt;lead_days  &gt; 0   (L)&lt;br&gt;safety_stock  ≥ 0   (SS)&lt;br&gt;pack_size  &gt; 0   (p)&lt;br&gt;on_order  ≥ 0   (OO)&lt;br&gt;backorder  ≥ 0   (BO)" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="10" y="209" width="260" height="120.5" as="geometry"/></mxCell><mxCell id="p2_c14" value="movement (движение)" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="187.25" width="260" height="21.75" as="geometry"/></mxCell><mxCell id="p2_c15" value="PK  id&lt;br&gt;FK  (product_code, warehouse_code)&lt;br&gt;kind  OPENING | RECEIPT | ISSUE&lt;br&gt;qty  &gt; 0&lt;br&gt;document  UNIQUE  (ключ запроса)&lt;br&gt;created_at" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="209" width="260" height="83" as="geometry"/></mxCell><mxCell id="p2_c17" value="reservation (резерв)" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="187.25" width="260" height="21.75" as="geometry"/></mxCell><mxCell id="p2_c18" value="PK  code  (= ключ запроса)&lt;br&gt;FK  (product_code, warehouse_code)&lt;br&gt;request_id  (заявка)&lt;br&gt;initial_qty  &gt; 0&lt;br&gt;remaining_qty  ≥ 0&lt;br&gt;status  ACTIVE | FULFILLED | RELEASED&lt;br&gt;CHECK remaining_qty ≤ initial_qty&lt;br&gt;CHECK ACTIVE только при remaining_qty &gt; 0&lt;br&gt;created_at" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="670" y="209" width="260" height="120.5" as="geometry"/></mxCell><mxCell id="p2_c20" value="processed_request (обработанный запрос)" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="384.5" width="260" height="21.75" as="geometry"/></mxCell><mxCell id="p2_c21" value="PK  request_key&lt;br&gt;operation  RESERVE | RELEASE | ISSUE | RECEIVE | OPENING&lt;br&gt;params  (JSON)&lt;br&gt;status&lt;br&gt;result  (JSON)&lt;br&gt;created_at" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=5;spacingRight=5;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="340" y="406.25" width="260" height="95.5" as="geometry"/></mxCell><mxCell id="p2_c23" value="reserve_event (история резерва)" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1;fontSize=11;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="384.5" width="260" height="21.75" as="geometry"/></mxCell><mxCell id="p2_c24" value="PK  id&lt;br&gt;FK  reservation_code&lt;br&gt;kind  CREATE | ISSUE | RELEASE&lt;br&gt;qty  &gt; 0&lt;br&gt;request_key  UNIQUE&lt;br&gt;created_at" style="rounded=0;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=10;align=left;verticalAlign=top;spacing